<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.NovaTransacaoController"
      spacing="15" prefWidth="380" styleClass="root-container">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Nova Transação" styleClass="titulo"/>

    <GridPane hgap="10" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="90"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Descrição:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoDescricao" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Valor:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoValor" promptText="Ex: 150.00" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Tipo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboTipo" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="Data:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="seletorData" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="Mensal:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <CheckBox fx:id="checkMensal" text="É uma transação recorrente" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Mês:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboMes" GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="Infinity"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#cancelar"/>
        <Button text="Salvar" onAction="#salvar" styleClass="botao-primario"/>
    </HBox>
</VBox>
